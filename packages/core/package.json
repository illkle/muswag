{
  "name": "@muswag/core",
  "version": "0.0.0",
  "private": true,
  "description": "Main-process services: the library database, session, sync, playlists and covers.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "source": {
        "types": "./src/test/index.ts",
        "default": "./src/test/index.ts"
      },
      "types": "./dist/test/index.d.ts",
      "import": "./dist/test/index.js",
      "default": "./dist/test/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate && node scripts/embed-migrations.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/sql-sqlite-node": "catalog:",
    "@muswag/shared": "workspace:*",
    "@muswag/tanstack-db-sqlite-mirror": "workspace:*",
    "@noble/hashes": "^2.4.0",
    "drizzle-orm": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "catalog:",
    "vitest": "catalog:"
  }
}
