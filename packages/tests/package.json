{
  "name": "@muswag/tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:sync-benchmark": "vitest run --config vitest.sync-benchmark.config.ts"
  },
  "dependencies": {
    "@muswag/shared": "workspace:*",
    "@tanstack/db": "catalog:",
    "@tanstack/node-db-sqlite-persistence": "catalog:",
    "better-sqlite3-test": "npm:better-sqlite3@13.0.3",
    "effect": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@muswag/tsconfig": "workspace:*",
    "@types/better-sqlite3": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "testcontainers": "^12.1.0",
    "vitest": "catalog:"
  }
}
