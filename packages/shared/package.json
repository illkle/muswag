{
  "name": "@muswag/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js",
      "default": "./dist/db/index.js"
    },
    "./player-queue": {
      "types": "./dist/player-queue.d.ts",
      "import": "./dist/player-queue.js",
      "default": "./dist/player-queue.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "^2.3.0",
    "@tanstack/db": "catalog:",
    "@tanstack/db-sqlite-persistence-core": "catalog:",
    "@tanstack/react-db": "catalog:",
    "effect": "catalog:",
    "fuse.js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@tanstack/node-db-sqlite-persistence": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "better-sqlite3-test": "catalog:",
    "vitest": "catalog:"
  }
}
