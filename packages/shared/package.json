{
  "name": "@muswag/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js",
      "default": "./dist/db/index.js"
    },
    "./player-queue": {
      "types": "./dist/player-queue.d.ts",
      "import": "./dist/player-queue.js",
      "default": "./dist/player-queue.js"
    },
    "./sync-node": {
      "types": "./dist/sync-node.d.ts",
      "import": "./dist/sync-node.js",
      "default": "./dist/sync-node.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write src test vitest.config.ts vitest.integration.config.ts",
    "format:check": "oxfmt --check src test vitest.config.ts vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@muswag/subsonic-api": "workspace:*",
    "@tanstack/db": "catalog:",
    "@tanstack/db-sqlite-persistence-core": "catalog:",
    "@tanstack/node-db-sqlite-persistence": "catalog:",
    "@tanstack/react-db": "catalog:",
    "effect": "catalog:",
    "fuse.js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@muswag/tsconfig": "workspace:*",
    "@types/better-sqlite3": "catalog:"
  }
}