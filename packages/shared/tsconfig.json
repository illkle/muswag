{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": true,
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.json",
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {}
      }
    ]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
