{
  "name": "@muswag/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Muswag desktop application built with Electron and Vite.",
  "homepage": "https://github.com/illkle/muswag",
  "author": {
    "name": "illkle",
    "email": "k.kelolov@gmail.com"
  },
  "type": "module",
  "main": "./out/main/index.cjs",
  "imports": {
    "#/*": "./src/renderer/*",
    "#shared/*": "./src/shared/*"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "pnpm typecheck && pnpm clean:out && pnpm build:main && pnpm build:preload && pnpm build:renderer",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build --config vite.config.ts",
    "clean:out": "node scripts/clean-out.ts",
    "start": "node scripts/start.ts",
    "dist": "pnpm build && electron-builder",
    "dist:dir": "pnpm build && electron-builder --dir",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:linux": "pnpm build && electron-builder --linux",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "effect": "catalog:",
    "electron-updater": "catalog:"
  },
  "devDependencies": {
    "@base-ui/react": "catalog:",
    "@effect/platform-browser": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@electron-toolkit/typed-ipc": "catalog:",
    "@electron-toolkit/utils": "catalog:",
    "@muswag/backend": "workspace:*",
    "@muswag/model": "workspace:*",
    "@muswag/tanstack-db-mirror": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@rolldown/plugin-babel": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/db": "catalog:",
    "@tanstack/devtools-vite": "catalog:",
    "@tanstack/react-db": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-hotkeys": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-ssr-query": "catalog:",
    "@tanstack/react-store": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@tanstack/store": "^0.11.2",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/electron-to-chromium": "catalog:",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-to-chromium": "catalog:",
    "fuse.js": "catalog:",
    "jsdom": "^30.1.1",
    "lodash-es": "^4.18.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-scan": "^0.5.7",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "usehooks-ts": "^3.1.1",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
