{
  "name": "@muswag/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Muswag desktop application built with Electron and electron-vite.",
  "homepage": "https://github.com/illkle/muswag",
  "author": {
    "name": "illkle",
    "email": "k.kelolov@gmail.com"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "imports": {
    "#/*": "./src/renderer/*",
    "#shared/*": "./src/shared/*"
  },
  "scripts": {
    "dev": "pnpm with-env electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "dist": "pnpm build && electron-builder",
    "dist:dir": "pnpm build && electron-builder --dir",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:linux": "pnpm build && electron-builder --linux",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write src electron.vite.config.ts vite.config.ts tsconfig.json tsconfig.node.json tsconfig.renderer.json",
    "format:check": "oxfmt --check src electron.vite.config.ts vite.config.ts tsconfig.json tsconfig.node.json tsconfig.renderer.json",
    "typecheck": "tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/typed-ipc": "^1.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fluentui/react-context-selector": "^9.2.18",
    "@muswag/shared": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/electron-db-sqlite-persistence": "^0.1.21",
    "@tanstack/node-db-sqlite-persistence": "catalog:",
    "@tanstack/react-db": "catalog:",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "^1.33.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-store": "^0.11.1",
    "@tanstack/react-virtual": "^3.14.9",
    "@tanstack/router-plugin": "^1.168.25",
    "@types/lodash-es": "^4.17.12",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-orm": "catalog:",
    "electron-updater": "^6.8.9",
    "fuse.js": "catalog:",
    "lodash-es": "^4.18.1",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-scan": "^0.5.7",
    "react-virtuoso": "^4.18.11",
    "scheduler": "^0.27.0",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "use-context-selector": "^2.0.0",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@muswag/tsconfig": "workspace:*",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.4.2",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "typescript": "catalog:",
    "vite": "^8.2.0",
    "vitest": "catalog:"
  }
}
