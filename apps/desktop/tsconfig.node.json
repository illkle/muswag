{
  "extends": "../../tsconfig.base.json",
  "include": ["vite.config.ts", "vite.main.config.ts", "vite.preload.config.ts", "vitest.config.ts", "scripts/**/*.ts", "src/main/**/*.ts", "src/preload/**/*.ts", "src/shared/**/*.ts"],
  "compilerOptions": {
    "module": "ESNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "paths": {
      "#shared/*": ["./src/shared/*"]
    },

    "moduleResolution": "bundler",
    "customConditions": ["source"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  }
}
