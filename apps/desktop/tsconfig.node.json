{
  "extends": "../../tsconfig.base.json",
  "include": ["electron.vite.config.ts", "vite.config.ts", "vitest.config.ts", "src/main/**/*.ts", "src/preload/**/*.ts", "src/shared/**/*.ts"],
  "compilerOptions": {
    "module": "ESNext",
    "lib": ["ES2022"],
    "types": ["node", "electron-vite/node"],
    "paths": {
      "#shared/*": ["./src/shared/*"]
    },

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  }
}
