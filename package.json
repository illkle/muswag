{
  "name": "muswag",
  "version": "0.1.0",
  "private": true,
  "description": "Muswag desktop application built with Electron and Vite.",
  "homepage": "https://github.com/illkle/muswag",
  "author": {
    "name": "illkle",
    "email": "k.kelolov@gmail.com"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "imports": {
    "#/*": "./src/renderer/*",
    "#shared/*": "./src/shared/*",
    "#core": "./src/core/index.ts",
    "#core/db": "./src/core/db/index.ts",
    "#core/sync-node": "./src/core/sync-node.ts",
    "#core/*": "./src/core/*.ts",
    "#subsonic-api": "./src/subsonic-api/index.ts"
  },
  "scripts": {
    "dev": "pnpm with-env vite",
    "build": "pnpm typecheck && vite build",
    "build:local:mac": "pnpm build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir --config.mac.identity=- --publish never",
    "preview": "pnpm build && electron .",
    "start": "electron .",
    "dist": "pnpm build && electron-builder",
    "dist:dir": "pnpm build && electron-builder --dir",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:linux": "pnpm build && electron-builder --linux",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write src tests vite.config.ts vitest.integration.config.ts vitest.sync-benchmark.config.ts tsconfig.json tsconfig.base.json tsconfig.core.json tsconfig.node.json tsconfig.renderer.json tsconfig.tests.json package.json",
    "format:check": "oxfmt --check src tests vite.config.ts vitest.integration.config.ts vitest.sync-benchmark.config.ts tsconfig.json tsconfig.base.json tsconfig.core.json tsconfig.node.json tsconfig.renderer.json tsconfig.tests.json package.json",
    "typecheck": "tsc --noEmit -p tsconfig.core.json && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:sync-benchmark": "vitest run --config vitest.sync-benchmark.config.ts",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "with-env": "dotenv -e .env --"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@effect/tsgo": "0.36.4",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/typed-ipc": "^1.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fluentui/react-context-selector": "^9.2.18",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/db": "^0.6.17",
    "@tanstack/db-sqlite-persistence-core": "^0.2.9",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/electron-db-sqlite-persistence": "^0.1.21",
    "@tanstack/node-db-sqlite-persistence": "^0.2.9",
    "@tanstack/react-db": "^0.1.95",
    "@tanstack/react-form": "^1.33.3",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-store": "^0.11.1",
    "@tanstack/react-virtual": "^3.14.9",
    "@tanstack/router-plugin": "^1.168.25",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "better-sqlite3-test": "npm:better-sqlite3@13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-orm": "0.45.2",
    "effect": "4.0.0-rc.109",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "fuse.js": "^7.5.0",
    "jsdom": "^30.0.1",
    "lodash-es": "^4.18.1",
    "nitro": "3.0.260610-beta",
    "oxfmt": "^0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-scan": "^0.5.7",
    "react-virtuoso": "^4.18.11",
    "scheduler": "^0.27.0",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "testcontainers": "^12.1.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "use-context-selector": "^2.0.0",
    "usehooks-ts": "^3.1.1",
    "vite": "^8.2.0",
    "vite-plugin-electron": "^1.1.1",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
