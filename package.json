{
  "name": "muswag",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:local:mac": "pnpm turbo run build --filter=@muswag/desktop && CSC_IDENTITY_AUTO_DISCOVERY=false pnpm --filter @muswag/desktop exec electron-builder --mac --dir --config.mac.identity=- --publish never",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:integration": "turbo run test:integration",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "^0.62.0",
    "oxlint": "1.77.0",
    "turbo": "^2.10.8",
    "typescript": "catalog:",
    "oxlint-tsgolint": "7.0.2001"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}