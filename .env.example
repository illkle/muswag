# Development-only renderer defaults. VITE_ values are public to the renderer.
VITE_DEFAULT_SUBSONIC_URL=
VITE_DEFAULT_SUBSONIC_USERNAME=
VITE_DEFAULT_SUBSONIC_PASSWORD=

# Development only: the renderer dev server's port, 5173 unless set.
MUSWAG_DEV_PORT=

# Development only: serves the app's IPC on this loopback port, so that a browser on another machine
# can run the renderer. See AGENTS.md.
MUSWAG_DEV_BRIDGE_PORT=
